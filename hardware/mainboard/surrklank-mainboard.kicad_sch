	(text "J6: remote panel, cable up to about 2 m. I2C at 100 kHz with 2.2k\npull-ups (GPIO25 SDA, GPIO26 SCL); GPIO27 = expander INT (RN1 pull-up).\nPin 9: LED anode via R9 from +5VSB (standby present).\nPin 10: LED anode via R10 from ATX +5V (main rails up).\nPanel LEDs to GND; use red/green/yellow (Vf about 2 V)."
		(exclude_from_sim no)
		(at 264.16 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid 6b1e6fea-8443-520f-98dd-65381452440e)
	)
